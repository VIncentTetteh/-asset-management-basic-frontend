# ── App Mode ─────────────────────────────────────────────────────────────────
# cloud      = vendor-hosted SaaS (default). License UI is hidden entirely.
# standalone = self-hosted on-premise. License status, renewal banner, and
#              write-action gating are all active.
NEXT_PUBLIC_APP_MODE=cloud

# ── API Proxy ─────────────────────────────────────────────────────────────────
# All /api/* browser requests are forwarded server-side by
# src/app/api/[...path]/route.ts to this target base URL.
#
# The value must end with /api (no trailing slash after that).
# Examples:
#   Local dev    → http://localhost:8080/api   (default — no change needed)
#   Railway/prod → https://your-backend.railway.app/api
#
# IMPORTANT: This is a SERVER-SIDE-ONLY variable (no NEXT_PUBLIC_ prefix).
# Set it in your deployment environment (Railway, Vercel, Docker, etc.).
API_TARGET_BASE=http://localhost:8080/api