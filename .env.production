# Build-time feature flags for the production/staging bundle.
#
# These are PRESENTATION flags only — they decide whether a route and its menu
# entry render. The API enforces the real thing with its own server-side flags,
# so turning one on here cannot grant access; turning one off here only hides a
# feature the server may still be serving.
#
# They must therefore MIRROR the backend flags, and the backend is the source of
# truth. A mismatch is not a security problem but it is a confusing one in both
# directions: on-here/off-there shows a menu entry whose page 404s, and
# off-here/on-there hides a feature that is live and paid for. The AI assistant
# spent a deploy in exactly that second state — enabled and answering over the
# API, with no way to reach it in the UI, because this file did not exist and
# the flags were passed by hand on a build command line.
#
# Backend flags currently enabled (see the migration that turns each one on):
#   commercial.document-attachments   V58
#   commercial.governed-ai            V60
#   commercial.governed-custom-fields V66
NEXT_PUBLIC_FEATURE_DOCUMENT_ATTACHMENTS=true
NEXT_PUBLIC_FEATURE_GOVERNED_AI=true
NEXT_PUBLIC_FEATURE_GOVERNED_CUSTOM_FIELDS=true

# Off, matching the backend: no migration enables these, so their pages would
# fail. Turn each one on here in the same change that enables it server-side.
NEXT_PUBLIC_FEATURE_OUTBOUND_WEBHOOKS=false
NEXT_PUBLIC_FEATURE_BOG_2026=false
NEXT_PUBLIC_FEATURE_PLATFORM_HEALTH=false
