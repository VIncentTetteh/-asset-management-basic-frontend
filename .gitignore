# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep the sanitized template tracked
.env*
!.env.example
# .env.production holds only NEXT_PUBLIC_ feature flags, which are compiled into
# the client bundle and so are public by definition. It is tracked deliberately:
# leaving these to whatever a deploy command happened to set is how the AI
# assistant shipped enabled on the server and invisible in the UI. No secret
# belongs in this file — anything secret goes to Secrets Manager.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/

# planning docs (keep out of repo)
*.docx
.gstack/

# Static export output (next build with output: "export")
/out/

# Local IDE run artefacts
/.run/
